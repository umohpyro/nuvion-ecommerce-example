# Sandbox API key from https://app.nuvion.dev/dashboard/settings
NUVION_API_KEY=

# The public encryption key shown next to your API key (a PEM block, "-----BEGIN PUBLIC KEY-----...").
# In an env file keep it on one line and write the line breaks as \n.
NUVION_ENCRYPTION_PUBLIC_KEY=

# The approved entity that receives the money, and one of its USD accounts.
# Open /setup after the first deploy: it lists the IDs to copy.
NUVION_ENTITY_ID=
NUVION_ACCOUNT_ID=

# Optional. The signing secret returned when you register a webhook.
NUVION_WEBHOOK_SECRET=

# Optional. The app refuses any host that is not *.nuvion.dev, so it can never reach production.
# NUVION_API_URL=https://api.nuvion.dev

# Optional. Public https address for the 3DS return. On Vercel it is detected automatically.
# PUBLIC_APP_URL=https://your-shop.example.com
