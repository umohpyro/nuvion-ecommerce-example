# This store is bring-your-own-key: visitors enter their own Nuvion sandbox keys on the Settings page,
# so there are no Nuvion keys to configure here.

# Required in production. A long random string that seals each visitor's cookie, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local development generates one for you.
SESSION_SECRET=

# Optional. The app refuses any host that is not *.nuvion.dev, so it can never reach production.
# NUVION_API_URL=https://api.nuvion.dev

# Optional. Public https address for the 3DS return. On Vercel it is detected automatically.
# PUBLIC_APP_URL=https://your-shop.example.com
